{
  "name": "react-gql-workshop",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace @workshop/web dev",
    "dev:api": "yarn workspace @workshop/api dev",
    "build": "yarn workspaces foreach -A run build",
    "format": "prettier --write ."
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3"
  }
}
